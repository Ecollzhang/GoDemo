{
    "swagger": "2.0",
    "info": {
        "description": "这是一个包含用户模块和学生成长记录模块的后端 API 服务",
        "title": "学生成长管理系统 API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/growth/add": {
            "post": {
                "description": "录入一条学生的成长轨迹记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "成长记录管理"
                ],
                "summary": "添加学生成长记录",
                "parameters": [
                    {
                        "description": "成长记录信息",
                        "name": "record",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.GrowthRecord"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.GrowthRecord"
                        }
                    }
                }
            }
        },
        "/growth/list": {
            "get": {
                "description": "查询全部的成长轨迹列表（后续可扩展分页和按学生查询）",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "成长记录管理"
                ],
                "summary": "获取所有学生成长记录",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.GrowthRecord"
                            }
                        }
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "description": "注册一个新账号",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "教师/管理员注册",
                "parameters": [
                    {
                        "description": "用户信息",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.User"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.GrowthRecord": {
            "type": "object"
        },
        "models.User": {
            "type": "object"
        }
    }
}